{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-image-generator-port/v1",
  "title": "Story image generator port payload",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {"const": "story-image-generator-port/v1"},
    "kind": {"enum": ["image_generator_request", "image_generator_result"]}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "image_generator_request"}}},
      "then": {
        "required": ["artifact_id", "operation", "execution_request_path", "execution_request_sha256", "input_artifacts", "output_targets", "attempt_id"],
        "properties": {
          "artifact_id": {"type": "string"},
          "operation": {"type": "string"},
          "execution_request_path": {"type": "string"},
          "execution_request_sha256": {"type": "string"},
          "input_artifacts": {"type": "array", "items": {"type": "object"}},
          "output_targets": {"type": "array", "items": {"type": "string"}},
          "attempt_id": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "image_generator_result"}}},
      "then": {
        "required": ["success", "operation", "output_artifacts", "provider", "model_or_tool", "request_id", "attempt_id", "execution_request_sha256", "adapter_version", "production_eligible", "usage_events", "failure"],
        "properties": {
          "success": {"type": "boolean"},
          "operation": {"type": "string"},
          "output_artifacts": {"type": "array", "items": {"type": "object"}},
          "provider": {"type": "string"},
          "model_or_tool": {"type": "string"},
          "request_id": {"type": "string"},
          "attempt_id": {"type": "string"},
          "execution_request_sha256": {"type": "string"},
          "adapter_version": {"type": "string"},
          "production_eligible": {"type": "boolean"},
          "usage_events": {"type": "array", "items": {"type": "object"}},
          "failure": {"type": ["object", "null"]}
        }
      }
    }
  ]
}
