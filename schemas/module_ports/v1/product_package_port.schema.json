{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-product-package-port/v1",
  "title": "Story product package filesystem port payload",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {"const": "story-product-package-port/v1"},
    "kind": {"enum": ["product_package_request", "product_package_result"]}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "product_package_request"}}},
      "then": {
        "required": ["artifact_id", "operation", "package_variant", "output_root", "source_artifacts", "output_targets", "attempt_id"],
        "properties": {
          "artifact_id": {"type": "string"},
          "operation": {"type": "string"},
          "package_variant": {"type": "string"},
          "output_root": {"type": "string"},
          "source_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package_variant", "source_path", "source_sha256", "destination_path"],
              "properties": {
                "package_variant": {"type": "string"},
                "source_path": {"type": "string"},
                "source_sha256": {"type": "string"},
                "destination_path": {"type": "string"}
              }
            }
          },
          "output_targets": {"type": "array", "items": {"type": "string"}},
          "attempt_id": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "product_package_result"}}},
      "then": {
        "required": ["success", "operation", "package_variant", "output_artifacts", "attempt_id", "adapter_version", "production_eligible", "usage_events", "failure"],
        "properties": {
          "success": {"type": "boolean"},
          "operation": {"type": "string"},
          "package_variant": {"type": "string"},
          "output_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package_variant", "source_path", "source_sha256", "path", "sha256", "production_eligible"],
              "properties": {
                "package_variant": {"type": "string"},
                "source_path": {"type": "string"},
                "source_sha256": {"type": "string"},
                "path": {"type": "string"},
                "sha256": {"type": "string"},
                "production_eligible": {"type": "boolean"}
              }
            }
          },
          "attempt_id": {"type": "string"},
          "adapter_version": {"type": "string"},
          "production_eligible": {"type": "boolean"},
          "usage_events": {"type": "array", "items": {"type": "object"}},
          "failure": {"type": ["object", "null"]}
        }
      }
    }
  ]
}
