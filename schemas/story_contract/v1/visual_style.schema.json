{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_style.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules", "style_profile"],
  "properties": {
    "rules": {"$ref": "common.schema.json#/$defs/rules"},
    "style_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_id", "description", "required_traits", "forbidden_traits", "provenance"],
      "properties": {
        "style_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required_traits": {"$ref": "common.schema.json#/$defs/stringList"},
        "forbidden_traits": {"$ref": "common.schema.json#/$defs/stringList"},
        "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
      }
    }
  }
}
