{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-r2v-plan-v4",
  "title": "Story R2V Director Plan v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "story_id",
    "source_audio",
    "policies",
    "assets",
    "continuity_groups",
    "shots"
  ],
  "properties": {
    "schema_version": {"const": "story-r2v-plan-v4"},
    "story_id": {"type": "string", "minLength": 1},
    "source_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "duration_seconds"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_generation_mode",
        "duration_choices",
        "max_reference_images",
        "min_retime_ratio",
        "max_retime_ratio",
        "max_attempts_per_shot"
      ],
      "properties": {
        "body_generation_mode": {"const": "reference_to_video"},
        "duration_choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"const": 6}, {"const": 10}],
          "items": false
        },
        "max_reference_images": {"type": "integer", "minimum": 1, "maximum": 7},
        "min_retime_ratio": {"type": "number", "minimum": 0.5, "maximum": 1},
        "max_retime_ratio": {"type": "number", "minimum": 1, "maximum": 1.5},
        "max_attempts_per_shot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Default autonomous quality versions (V1 plus at most one evidence-based V2). Exceptional V3 is governed by the separate 10% escalation gate and is not pre-authorized here."
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "continuity_groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/continuityGroup"}
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "path",
        "sha256",
        "runtime_eligible",
        "contains_characters"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["character", "population", "environment", "prop", "style", "storyboard"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_eligible": {"type": "boolean"},
        "contains_characters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identity_id": {"type": "string", "minLength": 1},
        "population_id": {"type": "string", "minLength": 1},
        "prop_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "design_source_kind": {"enum": ["single_view", "three_view_sheet", "expression_sheet", "composite_scene", "population_archetype", "ensemble_design_master", "isolated_prop", "empty_environment", "empty_environment_camera_view", "style_anchor", "semantic_storyboard"]},
        "appearance_summary": {"type": "string"},
        "scale_class": {"type": "string"},
        "environment_family_id": {"type": "string", "minLength": 1},
        "derived_from_asset_id": {"type": "string", "minLength": 1},
        "view_from_zone_id": {"type": "string", "minLength": 1},
        "view_target_zone_id": {"type": "string", "minLength": 1},
        "view_background_zone_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "state_family_id": {"type": "string", "minLength": 1},
        "state_family_master_path": {"type": "string", "minLength": 1},
        "state_family_master_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_delta": {"type": "string", "minLength": 1},
        "physical_contract": {"$ref": "#/$defs/physicalContract"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"const": "prop"},
              "runtime_eligible": {"const": true}
            },
            "required": ["kind", "runtime_eligible"]
          },
          "then": {"required": ["scale_class", "physical_contract"]}
        },
        {
          "if": {
            "properties": {"design_source_kind": {"const": "empty_environment_camera_view"}},
            "required": ["design_source_kind"]
          },
          "then": {
            "required": [
              "environment_family_id",
              "derived_from_asset_id",
              "view_from_zone_id",
              "view_target_zone_id",
              "view_background_zone_ids"
            ]
          }
        }
      ]
    },
    "physicalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_basis", "support_mode", "rigidity", "grip_or_contact", "forbidden_inferences"],
      "properties": {
        "scale_basis": {"enum": ["handheld_small", "handheld_two_hands", "body_scale", "furniture_scale", "environment_scale"]},
        "support_mode": {"enum": ["handheld", "freestanding", "grounded", "attached", "suspended", "loose"]},
        "rigidity": {"enum": ["rigid", "flexible", "soft", "fragile", "fluid"]},
        "grip_or_contact": {"type": "string", "minLength": 1},
        "forbidden_inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "description", "map_x", "map_y"],
      "properties": {
        "zone_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "map_x": {"type": "number"},
        "map_y": {"type": "number"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "zone_id", "description", "persistence", "occupancy_rule", "occupant_subject_id"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "zone_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "persistence": {"enum": ["fixed", "shot_local"]},
        "occupancy_rule": {"enum": ["none", "occupied_while_subject_in_scene"]},
        "occupant_subject_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "endpoint_a_zone_id", "endpoint_b_zone_id", "description"],
      "properties": {
        "axis_id": {"type": "string", "minLength": 1},
        "endpoint_a_zone_id": {"type": "string", "minLength": 1},
        "endpoint_b_zone_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "cameraSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_id",
        "axis_id",
        "camera_side",
        "shot_size",
        "camera_angle",
        "primary_subject_id",
        "primary_subject_type",
        "subject_zone_id",
        "screen_side",
        "eyeline_direction",
        "camera_origin_zone_id",
        "look_target_zone_id",
        "background_zone_ids",
        "camera_position_description"
        ,"environment_view_asset_id"
      ],
      "properties": {
        "setup_id": {"type": "string", "minLength": 1},
        "axis_id": {"type": "string", "minLength": 1},
        "camera_side": {"enum": ["side_a", "side_b", "on_axis"]},
        "shot_size": {"enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close", "extreme_close", "insert"]},
        "camera_angle": {"type": "string", "minLength": 1},
        "primary_subject_id": {"type": "string", "minLength": 1},
        "primary_subject_type": {"enum": ["character", "crowd", "prop", "environment"]},
        "subject_zone_id": {"type": "string", "minLength": 1},
        "screen_side": {"enum": ["left", "center", "right", "full_frame"]},
        "eyeline_direction": {"enum": ["camera_left", "camera_right", "toward_camera", "away", "none", "mixed"]},
        "camera_origin_zone_id": {"type": "string", "minLength": 1},
        "look_target_zone_id": {"type": "string", "minLength": 1},
        "background_zone_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "camera_position_description": {"type": "string", "minLength": 1}
        ,"environment_view_asset_id": {"type": "string", "minLength": 1}
      }
    },
    "colorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["white_balance", "palette", "prohibited_casts", "rationale"],
      "properties": {
        "white_balance": {"type": "string", "minLength": 1},
        "palette": {"type": "string", "minLength": 1},
        "prohibited_casts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "continuityGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "environment_asset_id",
        "location",
        "time_of_day",
        "lighting",
        "zones",
        "anchors",
        "axes",
        "camera_setups",
        "color_contract"
      ],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "environment_asset_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "time_of_day": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "zones": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/zone"}
        },
        "anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/anchor"}},
        "axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axis"}},
        "camera_setups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cameraSetup"}},
        "color_contract": {"$ref": "#/$defs/colorContract"},
        "scene_change_basis": {"type": "string"}
      }
    },
    "cameraPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_size", "end_size", "movement", "axis_id", "camera_setup_id", "screen_direction", "internal_cut", "visible_anchor_ids", "excluded_anchor_ids"],
      "properties": {
        "start_size": {"type": "string", "minLength": 1},
        "end_size": {"type": "string", "minLength": 1},
        "movement": {"type": "string", "minLength": 1},
        "axis_id": {"type": "string", "minLength": 1},
        "camera_setup_id": {"type": "string", "minLength": 1},
        "screen_direction": {"enum": ["left_to_right", "right_to_left", "toward_camera", "away_from_camera", "stationary", "mixed"]},
        "internal_cut": {"const": false},
        "visible_anchor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_anchor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "crowdPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_count", "identity_critical_characters", "population_asset_ids", "placement", "behavior", "face_readability"],
      "properties": {
        "mode": {"enum": ["none", "anonymous_background", "recurring_cohort", "identity_critical_ensemble"]},
        "target_count": {"type": ["integer", "null"], "minimum": 0},
        "identity_critical_characters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "population_asset_ids": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "placement": {"type": "string", "minLength": 1},
        "behavior": {"type": "string", "minLength": 1},
        "face_readability": {"enum": ["background_unreadable", "secondary", "identity_clear"]}
      }
    },
    "frameEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_size", "camera_angle", "visual_focus", "subject_layout", "eyeline", "action_phase", "state_summary", "acceptable_variation"],
      "properties": {
        "shot_size": {"enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close", "extreme_close", "insert"]},
        "camera_angle": {"type": "string", "minLength": 1},
        "visual_focus": {"type": "string", "minLength": 1},
        "subject_layout": {"type": "string", "minLength": 1},
        "eyeline": {"type": "string", "minLength": 1},
        "action_phase": {"type": "string", "minLength": 1},
        "state_summary": {"type": "object"},
        "acceptable_variation": {"type": "string", "minLength": 1}
      }
    },
    "continuityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "outgoing_value", "incoming_value", "match_required"],
      "properties": {
        "dimension": {"enum": ["axis", "eyeline", "screen_direction", "spatial_relation", "character_state", "prop_state", "action_phase", "lighting"]},
        "outgoing_value": {"type": "string", "minLength": 1},
        "incoming_value": {"type": "string", "minLength": 1},
        "match_required": {"type": "boolean"}
      }
    },
    "cutContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_shot_id", "cut_type", "motivation", "continuity_bindings", "deliberate_changes"],
      "properties": {
        "next_shot_id": {"type": "string", "minLength": 1},
        "cut_type": {"enum": ["direct", "shot_reverse_shot", "reaction", "match_action", "eyeline_match", "graphic_match", "scene_transition"]},
        "motivation": {"type": "string", "minLength": 1},
        "continuity_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/continuityBinding"}},
        "deliberate_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["shot_size", "camera_angle", "visual_focus", "subject", "action_phase", "location", "time"]}}
      }
    },
    "primaryBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "action"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "supportingAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "action"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_second", "end_second", "source_text", "performance", "visible_characters", "primary_beat", "supporting_actions", "camera"],
      "properties": {
        "start_second": {"type": "number", "minimum": 0},
        "end_second": {"type": "number", "exclusiveMinimum": 0},
        "source_text": {"type": "string", "minLength": 1},
        "performance": {"type": "string", "minLength": 1},
        "visible_characters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "primary_beat": {"$ref": "#/$defs/primaryBeat"},
        "supporting_actions": {"type": "array", "items": {"$ref": "#/$defs/supportingAction"}},
        "audio_speaker": {"type": "string"},
        "visual_focus": {"type": "string"},
        "listener_reaction": {"type": "string"},
        "prop_action": {"type": "string"},
        "camera": {"type": "string", "minLength": 1}
      }
    },
    "propTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prop_id", "before_state", "visible_trigger_action", "after_state", "exit_evidence", "next_shot_asset_id"],
      "properties": {
        "prop_id": {"type": "string", "minLength": 1},
        "before_state": {"type": "string", "minLength": 1},
        "visible_trigger_action": {"type": "string", "minLength": 1},
        "after_state": {"type": "string", "minLength": 1},
        "exit_evidence": {"type": "string", "minLength": 1},
        "next_shot_asset_id": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "assemblyTrim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor"],
      "properties": {
        "anchor": {"enum": ["start", "center", "end", "explicit"]},
        "start_second": {"type": "number", "minimum": 0}
      }
    },
    "narrativeVisualization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "narrative_layer",
        "reality_anchor",
        "content_to_visualize",
        "entry_cue",
        "exit_cue",
        "ppt_readability_strategy",
        "duplicate_identity_policy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "literal_action",
            "speaker_performance",
            "listener_reaction",
            "speech_visual_bubble",
            "imagined_cutaway",
            "flashback",
            "metaphoric_insert"
          ]
        },
        "narrative_layer": {
          "enum": ["current_fact", "proposed_action", "imagined_example", "memory", "explanation", "future_result"]
        },
        "reality_anchor": {"type": "string", "minLength": 1},
        "content_to_visualize": {"type": "string", "minLength": 1},
        "entry_cue": {"type": "string", "minLength": 1},
        "exit_cue": {"type": "string", "minLength": 1},
        "ppt_readability_strategy": {"type": "string", "minLength": 1},
        "duplicate_identity_policy": {
          "enum": ["forbid", "framed_representation_only", "same_identity_memory_only"]
        }
      }
    },
    "focusContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_subject_id",
        "primary_subject_type",
        "secondary_subject_ids",
        "background_subject_ids",
        "off_screen_subject_ids",
        "visual_priority",
        "composition_rule"
      ],
      "properties": {
        "primary_subject_id": {"type": "string", "minLength": 1},
        "primary_subject_type": {"enum": ["character", "crowd", "prop", "environment"]},
        "secondary_subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "background_subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "off_screen_subject_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "visual_priority": {"type": "string", "minLength": 1},
        "composition_rule": {"type": "string", "minLength": 1}
      }
    },
    "subjectPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_type", "entry_presence", "exit_presence", "entry_zone_id", "exit_zone_id", "entry_world_presence", "exit_world_presence", "entry_world_zone_id", "exit_world_zone_id", "visibility_reason"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "subject_type": {"enum": ["character", "crowd", "prop", "environment"]},
        "entry_presence": {"enum": ["on_screen", "off_screen"]},
        "exit_presence": {"enum": ["on_screen", "off_screen"]},
        "entry_zone_id": {"type": ["string", "null"], "minLength": 1},
        "exit_zone_id": {"type": ["string", "null"], "minLength": 1},
        "entry_world_presence": {"enum": ["in_scene", "outside_scene"]},
        "exit_world_presence": {"enum": ["in_scene", "outside_scene"]},
        "entry_world_zone_id": {"type": ["string", "null"], "minLength": 1},
        "exit_world_zone_id": {"type": ["string", "null"], "minLength": 1},
        "visibility_reason": {"type": "string", "minLength": 1}
      }
    },
    "propContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop_id",
        "asset_id",
        "entry_presence",
        "exit_presence",
        "entry_state",
        "exit_state",
        "owner_id",
        "zone_id",
        "scale_basis",
        "support_mode",
        "rigidity",
        "grip_or_contact",
        "forbidden_inferences"
      ],
      "properties": {
        "prop_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": ["string", "null"], "minLength": 1},
        "entry_presence": {"enum": ["present", "absent"]},
        "exit_presence": {"enum": ["present", "absent"]},
        "entry_state": {"type": "string", "minLength": 1},
        "exit_state": {"type": "string", "minLength": 1},
        "owner_id": {"type": "string", "minLength": 1},
        "zone_id": {"type": ["string", "null"], "minLength": 1},
        "scale_basis": {"enum": ["handheld_small", "handheld_two_hands", "body_scale", "furniture_scale", "environment_scale"]},
        "support_mode": {"enum": ["handheld", "freestanding", "grounded", "attached", "suspended", "loose"]},
        "rigidity": {"enum": ["rigid", "flexible", "soft", "fragile", "fluid"]},
        "grip_or_contact": {"type": "string", "minLength": 1},
        "forbidden_inferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "generation_mode",
        "source_start",
        "source_end",
        "story_text",
        "provider_seconds",
        "reference_asset_ids",
        "continuity_group",
        "relation_to_previous",
        "initial_visible_characters",
        "entering_characters",
        "exiting_characters",
        "crowd_plan",
        "focus_contract",
        "subject_presence",
        "prop_contracts",
        "camera_plan",
        "opening_frame",
        "closing_frame",
        "cut_to_next",
        "entry_state",
        "exit_state",
        "performance_beats",
        "prop_state_transitions",
        "prompt"
      ],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "generation_mode": {"const": "reference_to_video"},
        "source_start": {"type": "number", "minimum": 0},
        "source_end": {"type": "number", "exclusiveMinimum": 0},
        "story_text": {"type": "string", "minLength": 1},
        "provider_seconds": {"enum": [6, 10]},
        "reference_asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "continuity_group": {"type": "string", "minLength": 1},
        "relation_to_previous": {"enum": ["first", "same_scene_continuation", "same_scene_angle_change", "reaction_cut", "match_action", "new_scene"]},
        "initial_visible_characters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
